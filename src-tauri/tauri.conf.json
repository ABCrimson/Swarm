{
  "$schema": "https://schema.tauri.app/config/3.0.0-alpha.2",
  "productName": "SWARM Orchestrator",
  "identifier": "dev.crimson.swarm-orchestrator",
  "version": "../package.json",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "SWARM Orchestrator",
        "width": 1440,
        "height": 900,
        "minWidth": 800,
        "minHeight": 500,
        "visible": false,
        "decorations": true,
        "transparent": false,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --enable-features=WebGPU"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self'; connect-src ipc: http://ipc.localhost https://api.anthropic.com; font-src 'self'; worker-src 'self' blob:; object-src 'none'; base-uri 'none'; form-action 'none'",
      "dangerousDisableAssetCspModification": ["style-src"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/icon.png",
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "fs": {
      "requireLiteralLeadingDot": false
    },
    "updater": {
      "endpoints": ["https://github.com/ABCrimson/Swarm/releases/latest/download/latest.json"],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDMxRkJBM0MwMjdBNDRDMDMKUldRRFRLUW53S1A3TWRFaUtVM3FrODZOTWJwVHUrQys4eGovakpxc1ZzSEtXanJLbEMwN2xEV0MK",
      "requireSignedVersion": true
    }
  }
}
