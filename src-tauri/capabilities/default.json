{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "What the SWARM Orchestrator webview may do. It may invoke exactly the app commands listed as allow-* (the manifest in build.rs generates one per command), and no other. File access carries no static path scope: the fs commands read, list, stat and write only what the user picks in an open or save dialog, which grants that path (a directory with all its contents, dot entries included, when opened recursively) for the rest of the session. They never create directories, delete or rename.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "allow-spawn-worker",
    "allow-pause-worker",
    "allow-resume-worker",
    "allow-kill-worker",
    "allow-list-workers",
    "allow-worker-input",
    "allow-resize-worker",
    "allow-set-max-workers",
    "allow-validate-repo-root",
    "allow-git-ship-preflight",
    "allow-git-stage-commit",
    "allow-git-push",
    "allow-ship-context",
    "allow-ship-compare-url",
    "allow-create-session",
    "allow-delete-session",
    "allow-list-sessions",
    "allow-get-session",
    "allow-session-add-worker",
    "allow-session-remove-worker",
    "allow-agent-turn-started",
    "allow-agent-spawn",
    "allow-agent-send-turn",
    "allow-agent-cancel",
    "allow-agent-shutdown",
    "allow-agent-probe",
    "allow-agent-permission-respond",
    "allow-set-agent-concurrency",
    "allow-read-config",
    "allow-write-config",
    "allow-read-file",
    "allow-write-file",
    "allow-get-metrics",
    "allow-events-since",
    "allow-bus-send",
    "allow-bus-list-channels",
    "allow-check-for-updates",
    "allow-send-notification",
    "fs:allow-read-file",
    "fs:allow-read-dir",
    "fs:allow-exists",
    "fs:allow-stat",
    "fs:allow-write-file",
    {
      "identifier": "fs:scope",
      "deny": [
        { "path": "$APPDATA/**" },
        { "path": "$HOME/.ssh/**" },
        { "path": "$HOME/.gnupg/**" },
        { "path": "$HOME/.aws/**" },
        { "path": "$HOME/.azure/**" },
        { "path": "$HOME/.kube/**" },
        { "path": "$HOME/.docker/**" },
        { "path": "$HOME/.config/gh/**" },
        { "path": "$HOME/.claude/**" },
        { "path": "$HOME/.codex/**" },
        { "path": "$HOME/.git-credentials" },
        { "path": "$HOME/.netrc" }
      ]
    },
    "fs:deny-default",
    "dialog:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [{ "url": "https://*/*/*/compare/*" }]
    },
    {
      "identifier": "opener:allow-open-path",
      "allow": [{ "path": "$HOME/.swarm/worktrees/**" }]
    },
    "store:default"
  ]
}
