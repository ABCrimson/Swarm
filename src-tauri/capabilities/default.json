{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "What the SWARM Orchestrator webview may do. File access carries no static path scope: the fs commands read, list, stat and write only what the user picks in an open or save dialog, which grants that path (a directory with all its contents, dot entries included, when opened recursively) for the rest of the session. They never create directories, delete or rename.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "fs:allow-read-file",
    "fs:allow-read-dir",
    "fs:allow-exists",
    "fs:allow-stat",
    "fs:allow-write-file",
    {
      "identifier": "fs:scope",
      "deny": [
        { "path": "$APPDATA/**" },
        { "path": "$HOME/.ssh/**" },
        { "path": "$HOME/.gnupg/**" },
        { "path": "$HOME/.aws/**" },
        { "path": "$HOME/.azure/**" },
        { "path": "$HOME/.kube/**" },
        { "path": "$HOME/.docker/**" },
        { "path": "$HOME/.config/gh/**" },
        { "path": "$HOME/.claude/**" },
        { "path": "$HOME/.codex/**" },
        { "path": "$HOME/.git-credentials" },
        { "path": "$HOME/.netrc" }
      ]
    },
    "fs:deny-default",
    "dialog:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [{ "url": "https://*/*/*/compare/*" }]
    },
    {
      "identifier": "opener:allow-open-path",
      "allow": [{ "path": "$HOME/.swarm/worktrees/**" }]
    },
    "store:default"
  ]
}
