{
  "name": "swarm-orchestrator",
  "version": "0.13.0",
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": "26.7.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && tsc -p tsconfig.worker.json --noEmit && vite build",
    "build:web": "tsc --noEmit && tsc -p tsconfig.worker.json --noEmit && vite build --mode web",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.worker.json --noEmit",
    "check": "biome check --write .",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "analyze": "vite build --mode analyze",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.116.0",
    "@crimson_dev/use-resize-observer": "1.0.0",
    "@fontsource-variable/dm-sans": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/syne": "5.3.0",
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/plugin-dialog": "2.7.2",
    "@tauri-apps/plugin-fs": "2.5.1",
    "@tauri-apps/plugin-shell": "2.3.5",
    "@tauri-apps/plugin-store": "2.4.4",
    "@xterm/addon-fit": "0.12.0-beta.299",
    "@xterm/addon-webgl": "0.20.0-beta.298",
    "@xterm/xterm": "6.1.0-beta.302",
    "@xyflow/react": "12.11.3",
    "date-fns": "4.4.0",
    "elkjs": "0.12.0",
    "gsap": "3.15.0",
    "immer": "11.1.16",
    "jotai": "2.20.2",
    "modern-cmdk": "1.2.1",
    "motion": "13.1.0",
    "radix-ui": "1.6.7",
    "react": "19.3.0-canary-22e4f993-20260811",
    "react-dom": "19.3.0-canary-22e4f993-20260811",
    "recharts": "3.10.1",
    "sonner": "2.0.8",
    "tailwindcss": "4.3.3",
    "zod": "4.5.0-canary.20260812T211928",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@babel/core": "8.0.1",
    "@biomejs/biome": "2.5.8",
    "@playwright/test": "1.62.1",
    "@rolldown/plugin-babel": "0.2.3",
    "@tailwindcss/vite": "4.3.3",
    "@tauri-apps/cli": "2.11.4",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.4",
    "@types/babel__core": "7.20.5",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "@vitest/coverage-v8": "4.1.10",
    "@webgpu/types": "0.1.71",
    "babel-plugin-react-compiler": "1.0.0",
    "jsdom": "29.1.1",
    "rollup-plugin-visualizer": "7.0.1",
    "typescript": "7.0.2",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  },
  "imports": {
    "#components/*": "./src/components/*.tsx",
    "#store/*": "./src/store/*.ts",
    "#lib/*": "./src/lib/*.ts",
    "#workers/*": "./src/workers/*.ts",
    "#hooks/*": "./src/hooks/*.ts",
    "#pages/*": "./src/pages/*.tsx",
    "#styles/*": "./src/styles/*.css"
  }
}
