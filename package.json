{
  "name": "swarm-orchestrator",
  "license": "MIT",
  "version": "0.13.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": "27.0.0-nightly202609233d85c94cfa"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "27.0.0-nightly202609233d85c94cfa",
      "onFail": "download"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "pnpm typecheck && vite build",
    "build:web": "pnpm typecheck && vite build --mode web",
    "build:site": "node scripts/build-site.ts",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.worker.json && tsc -p tsconfig.node.json",
    "check:compiler": "node scripts/check-react-compiler.ts",
    "check": "biome check --write .",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "analyze": "vite build --mode analyze",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.128.0",
    "@crimson_dev/use-resize-observer": "1.0.1",
    "@fontsource-variable/dm-sans": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/syne": "5.3.0",
    "@tauri-apps/api": "3.0.0-alpha.1",
    "@tauri-apps/plugin-dialog": "3.0.0-alpha.1",
    "@tauri-apps/plugin-fs": "3.0.0-alpha.1",
    "@tauri-apps/plugin-opener": "3.0.0-alpha.1",
    "@tauri-apps/plugin-store": "3.0.0-alpha.1",
    "@xterm/addon-fit": "0.12.0-beta.301",
    "@xterm/addon-webgl": "0.20.0-beta.300",
    "@xterm/xterm": "6.1.0-beta.304",
    "@xyflow/react": "12.11.6",
    "date-fns": "5.0.0-alpha.0",
    "elkjs": "0.12.0",
    "immer": "11.1.18",
    "jotai": "3.0.0",
    "modern-cmdk": "1.2.2",
    "motion": "13.4.2",
    "radix-ui": "1.7.0-rc.1785512840124",
    "react": "19.3.0-canary-d083ec1d-20260922",
    "react-dom": "19.3.0-canary-d083ec1d-20260922",
    "react-is": "19.3.0-canary-d083ec1d-20260922",
    "recharts": "3.11.0-canary.4",
    "sonner": "2.0.8",
    "tailwindcss": "0.0.0-insiders.41d9cae",
    "zod": "4.6.5",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@biomejs/biome": "2.5.14",
    "@playwright/test": "1.64.0-alpha-2026-09-23",
    "@rolldown/plugin-babel": "0.2.4",
    "@tailwindcss/vite": "0.0.0-insiders.41d9cae",
    "@tauri-apps/cli": "3.0.0-alpha.2",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "26.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "5.0.1",
    "@webgpu/types": "0.1.74",
    "babel-plugin-react-compiler": "0.0.0-experimental-a1856f3-20260507",
    "jsdom": "30.1.1",
    "marked": "18.0.14",
    "oxc-transform-react": "0.151.0",
    "rollup-plugin-visualizer": "7.1.1",
    "typescript": "7.1.0-dev.20260923.1",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  },
  "imports": {
    "#components/*": "./src/components/*.tsx",
    "#store/*": "./src/store/*.ts",
    "#lib/*": "./src/lib/*.ts",
    "#hooks/*": "./src/hooks/*.ts",
    "#pages/*": "./src/pages/*.tsx",
    "#styles/*": "./src/styles/*",
    "#test/*": "./src/test/*.ts"
  }
}
