{
  "name": "swarm-orchestrator",
  "license": "MIT",
  "version": "0.14.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.17.0",
  "engines": {
    "node": "28.0.0-nightly202610304e48b9b06b"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "28.0.0-nightly202610304e48b9b06b",
      "onFail": "download"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "pnpm typecheck && vite build",
    "build:web": "pnpm typecheck && vite build --mode web",
    "build:site": "node scripts/build-site.ts",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.worker.json && tsc -p tsconfig.node.json",
    "check:compiler": "node scripts/check-react-compiler.ts",
    "check": "biome check --write .",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "analyze": "vite build --mode analyze",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.3.0",
    "@crimson_dev/use-resize-observer": "1.0.1",
    "@fontsource-variable/dm-sans": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/syne": "5.3.0",
    "@tauri-apps/api": "3.0.0-alpha.3",
    "@tauri-apps/plugin-dialog": "3.0.0-alpha.4",
    "@tauri-apps/plugin-fs": "3.0.0-alpha.3",
    "@tauri-apps/plugin-opener": "3.0.0-alpha.3",
    "@tauri-apps/plugin-store": "3.0.0-alpha.3",
    "@xterm/addon-fit": "0.12.0-beta.332",
    "@xterm/addon-webgl": "0.20.0-beta.329",
    "@xterm/xterm": "6.1.0-beta.336",
    "@xyflow/react": "12.12.0",
    "elkjs": "0.12.1",
    "immer": "11.2.9",
    "jotai": "3.0.1",
    "modern-cmdk": "1.2.2",
    "motion": "14.9.0",
    "radix-ui": "1.8.2-rc.1791984254107",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-is": "19.3.1",
    "recharts": "3.11.0-canary.8",
    "sonner": "2.0.8",
    "tailwindcss": "0.0.0-insiders.8cc0551",
    "temporal-polyfill": "1.0.6",
    "zod": "4.6.7",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@oxc-transform-react/binding-wasm32-wasip1": "0.156.0",
    "@playwright/test": "1.65.0-alpha-2026-10-30",
    "@tailwindcss/vite": "0.0.0-insiders.8cc0551",
    "@tauri-apps/cli": "3.0.0-alpha.5",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.1.0-beta.1",
    "@webgpu/types": "0.1.74",
    "jsdom": "30.1.3",
    "knip": "6.44.0",
    "marked": "18.1.2",
    "oxc-transform-react": "0.156.0",
    "rollup-plugin-visualizer": "7.1.1",
    "typescript": "7.1.0-dev.20261030.1",
    "vite": "8.3.5",
    "vitest": "5.1.0-beta.1"
  },
  "imports": {
    "#components/*": "./src/components/*.tsx",
    "#store/*": "./src/store/*.ts",
    "#lib/*": "./src/lib/*.ts",
    "#hooks/*": "./src/hooks/*.ts",
    "#pages/*": "./src/pages/*.tsx",
    "#styles/*": "./src/styles/*",
    "#test/*": "./src/test/*.ts"
  }
}
