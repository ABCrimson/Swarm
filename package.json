{
  "name": "swarm-orchestrator",
  "license": "MIT",
  "version": "0.13.1",
  "type": "module",
  "packageManager": "pnpm@12.0.0",
  "engines": {
    "node": "26.8.1"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && tsc -p tsconfig.worker.json --noEmit && vite build",
    "build:web": "tsc --noEmit && tsc -p tsconfig.worker.json --noEmit && vite build --mode web",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.worker.json --noEmit",
    "check": "biome check --write .",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "analyze": "vite build --mode analyze",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.121.0",
    "@crimson_dev/use-resize-observer": "1.0.0",
    "@fontsource-variable/dm-sans": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/syne": "5.3.0",
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/plugin-dialog": "2.7.2",
    "@tauri-apps/plugin-fs": "2.5.1",
    "@tauri-apps/plugin-shell": "2.3.5",
    "@tauri-apps/plugin-store": "2.4.4",
    "@xterm/addon-fit": "0.12.0-beta.300",
    "@xterm/addon-webgl": "0.20.0-beta.299",
    "@xterm/xterm": "6.1.0-beta.303",
    "@xyflow/react": "12.11.5",
    "date-fns": "4.4.0",
    "elkjs": "0.12.0",
    "gsap": "3.15.0",
    "immer": "11.1.18",
    "jotai": "2.20.3",
    "modern-cmdk": "1.2.1",
    "motion": "13.1.1",
    "radix-ui": "1.7.0-rc.1785512840124",
    "react": "19.3.0-canary-a1124489-20260826",
    "react-dom": "19.3.0-canary-a1124489-20260826",
    "recharts": "3.11.0-canary.0",
    "sonner": "2.0.8",
    "tailwindcss": "4.3.3",
    "zod": "4.5.0-canary.20260827T054049",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@babel/core": "8.0.1",
    "@biomejs/biome": "2.5.10",
    "@playwright/test": "1.63.0-alpha-2026-08-27",
    "@rolldown/plugin-babel": "0.2.3",
    "@tailwindcss/vite": "4.3.3",
    "@tauri-apps/cli": "2.11.4",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.6",
    "@types/babel__core": "7.20.5",
    "@types/node": "26.4.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.0",
    "@vitest/coverage-v8": "5.0.0-rc.2",
    "@webgpu/types": "0.1.72",
    "babel-plugin-react-compiler": "1.0.0",
    "jsdom": "30.0.1",
    "rollup-plugin-visualizer": "7.1.1",
    "typescript": "7.1.0-dev.20260826.1",
    "vite": "8.2.2",
    "vitest": "5.0.0-rc.2"
  },
  "imports": {
    "#components/*": "./src/components/*.tsx",
    "#store/*": "./src/store/*.ts",
    "#lib/*": "./src/lib/*.ts",
    "#workers/*": "./src/workers/*.ts",
    "#hooks/*": "./src/hooks/*.ts",
    "#pages/*": "./src/pages/*.tsx",
    "#styles/*": "./src/styles/*.css"
  }
}
