{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": ["**", "!**/*.svg", "!.claude", "!site/**/*.html"]
  },
  "plugins": [
    {
      "path": "./biome-plugins/no-raw-oklch.grit",
      "includes": [
        "src/**/*.ts",
        "src/**/*.tsx",
        "!src/**/*.test.ts",
        "!src/**/*.test.tsx",
        "!src/hooks/useTerminal.ts",
        "!src/lib/chart-theme.ts",
        "!src/lib/particles.ts",
        "!src/lib/postprocess.ts",
        "!src/lib/syntax-highlight.ts"
      ]
    },
    {
      "path": "./biome-plugins/no-raw-oklch-css.grit",
      "includes": ["src/**/*.css", "!src/styles/tokens.css"]
    }
  ],
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100,
    "lineEnding": "lf"
  },
  "linter": {
    "enabled": true,
    "domains": {
      "playwright": "recommended",
      "react": "recommended",
      "tailwind": "recommended",
      "test": "recommended"
    },
    "rules": {
      "preset": "recommended",
      "correctness": {
        "noUnusedImports": "error",
        "noUnusedVariables": "error"
      },
      "style": {
        "noNonNullAssertion": "warn",
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "patterns": [
              {
                "group": ["../*", "../**"],
                "message": "Use a # subpath import"
              }
            ]
          }
        },
        "useConst": "error"
      },
      "suspicious": {
        "noExplicitAny": "error"
      },
      "nursery": {
        "noAccidentalBitwiseOperators": "error",
        "noArgumentsCallerOrCallee": "error",
        "noArrayMethodsOnArguments": "error",
        "noArraySortForMinMax": "error",
        "noBooleanSortComparator": "error",
        "noConsoleSpaces": "error",
        "noConstantComparisons": "error",
        "noDoubleComparison": "error",
        "noDuplicateMapKeys": "error",
        "noEagerArrayMethodsInLoops": "error",
        "noErasingOperation": "error",
        "noFloatingPromises": "error",
        "noInvalidThis": "error",
        "noMagicArrayFlatDepth": "error",
        "noMeaninglessVoidOperator": "error",
        "noNegatedArrayPredicate": "error",
        "noNewRequire": "error",
        "noNumberArgumentOutOfRange": "error",
        "noObjectConstructor": "error",
        "noOctal": "error",
        "noPathConcat": "error",
        "noReactObjectTypeAsDefaultProp": "error",
        "noReturnInFinally": "error",
        "noSelfNestedLayer": "error",
        "noSharedBranchCode": "error",
        "noSubtractionComparison": "error",
        "noTailwindLegacyUtilities": "error",
        "noTailwindRawColors": "warn",
        "noUninvokedArrayCallback": "error",
        "noUnmodifiedLoopCondition": "error",
        "noUnreadableIife": "error",
        "noUnsafeUnaryMinus": "error",
        "noUselessAssignment": "error",
        "noUselessCall": "error",
        "noUselessDateGetTime": "error",
        "noUselessRecursion": "error",
        "noUselessSplice": "error",
        "noXorAsExponentiation": "error",
        "noYamlBooleanKeys": "error",
        "noZeroLengthUnit": "error",
        "useBlockStatementOverIife": "error",
        "useConsistentLightnessNotation": {
          "level": "error",
          "options": {
            "notation": "number"
          }
        },
        "useExpectToContain": "error",
        "useFlatMathMinMax": "error",
        "useMathAbs": "error",
        "useMathTrunc": "error",
        "useModernMathApis": "error",
        "usePackageJsonEngines": "error",
        "usePackageJsonValidCpu": "error",
        "usePackageJsonValidEngines": "error",
        "useReactCompiler": "warn"
      }
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "css": {
    "parser": {
      "cssModules": false,
      "tailwindDirectives": true
    },
    "linter": {
      "enabled": true
    },
    "formatter": {
      "enabled": true
    }
  },
  "markdown": {
    "formatter": {
      "enabled": false
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all",
      "arrowParentheses": "always"
    }
  }
}
