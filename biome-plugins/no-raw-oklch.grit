// `split` leaves the text after each `oklch(` as one element, so every
// numeric color in a class string is checked on its own. Only the first
// element (the text before any `oklch(`) is not a color; a template chunk
// that starts with a digit there fails safe, as a false positive.
or {
  JsStringLiteralExpression(),
  JsxString(),
  JsTemplateChunkElement()
} as $literal where {
  $literal <: r"(?s).*oklch\(\s*[0-9.].*",
  $after = split($literal, "oklch("),
  $after <: some $color where { $color <: r"(?s)\s*[0-9.].*", not known_raw_oklch($color) },
  register_diagnostic(span=$literal, message="Raw oklch() literal: use a token from src/styles/tokens.css (a utility, a /N modifier, var(--color-…) or oklch(from var(--color-…) …)). Known exceptions live in biome-plugins/no-raw-oklch.grit.", severity="error")
}
