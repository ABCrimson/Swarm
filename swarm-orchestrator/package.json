{
  "name": "swarm-orchestrator",
  "version": "0.9.9",
  "type": "module",
  "engines": {
    "node": "25.8.1"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "check": "biome check --write .",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "analyze": "VITE_BUNDLE_ANALYZE=true vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.78.0",
    "@crimson_dev/use-resize-observer": "1.0.0",
    "@radix-ui/react-dialog": "1.1.15",
    "@radix-ui/react-primitive": "2.1.4",
    "@tauri-apps/api": "2.10.1",
    "@tauri-apps/plugin-dialog": "2.6.0",
    "@tauri-apps/plugin-fs": "2.4.5",
    "@tauri-apps/plugin-shell": "2.3.5",
    "@tauri-apps/plugin-store": "2.4.2",
    "@xterm/addon-fit": "0.12.0-beta.168",
    "@xterm/addon-webgl": "0.20.0-beta.192",
    "@xterm/xterm": "6.1.0-beta.193",
    "@xyflow/react": "12.10.1",
    "date-fns": "4.1.0",
    "elkjs": "0.11.1",
    "framer-motion": "12.36.0",
    "gsap": "3.14.2",
    "immer": "11.1.4",
    "jotai": "2.18.1",
    "modern-cmdk": "1.1.5",
    "react": "19.3.0-canary-5e9eedb5-20260312",
    "react-dom": "19.3.0-canary-5e9eedb5-20260312",
    "recharts": "3.8.0",
    "sonner": "2.0.7",
    "tailwindcss": "4.2.1",
    "vaul": "1.1.2",
    "zod": "4.4.0-canary.20260125T215152",
    "zustand": "5.0.11"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.6",
    "@playwright/test": "1.52.0",
    "@tailwindcss/vite": "4.2.1",
    "@tauri-apps/cli": "2.10.1",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "4.5.2",
    "@vitest/coverage-v8": "3.2.1",
    "@webgpu/types": "0.1.69",
    "babel-plugin-react-compiler": "1.0.0",
    "jsdom": "26.1.0",
    "rollup-plugin-visualizer": "7.0.1",
    "typescript": "6.0.0-dev.20260313",
    "vite": "8.0.0",
    "vitest": "3.2.1"
  },
  "imports": {
    "#components/*": "./src/components/*.tsx",
    "#store/*": "./src/store/*.ts",
    "#lib/*": "./src/lib/*.ts",
    "#workers/*": "./src/workers/*.ts",
    "#hooks/*": "./src/hooks/*.ts",
    "#pages/*": "./src/pages/*.tsx",
    "#styles/*": "./src/styles/*.css"
  }
