{"jsonrpc":"2.0","method":"item/completed","params":{"threadId":"thread-tool-0001","turnId":"turn-tool-0001","item":{"id":"item-cmd-1","type":"commandExecution","command":"cat data.txt","exitCode":0,"output":"widget-alpha,42\nwidget-beta,17\n"}}}
