{
  "$schema": "https://schema.tauri.app/config/2.11.5",
  "productName": "SWARM Orchestrator",
  "identifier": "dev.crimson.swarm-orchestrator",
  "version": "0.11.2",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "SWARM Orchestrator",
        "width": 1440,
        "height": 900,
        "minWidth": 800,
        "minHeight": 500,
        "decorations": true,
        "transparent": false,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --enable-features=WebGPU"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' asset: https://asset.localhost; connect-src ipc: http://ipc.localhost https://api.anthropic.com; font-src 'self'; worker-src 'self' blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/crimson-dev/swarm-orchestrator/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDMxRkJBM0MwMjdBNDRDMDMKUldRRFRLUW53S1A3TWRFaUtVM3FrODZOTWJwVHUrQys4eGovakpxc1ZzSEtXanJLbEMwN2xEV0MK"
    },
    "shell": {
      "open": "^([a-zA-Z]:[\\\\/]|/|\\\\\\\\).+"
    }
  }
}
